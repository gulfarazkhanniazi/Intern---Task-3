# Copy to .env and fill in real values. Never commit .env.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Domain verified in Resend. Used to build the "from" address
# unless CONTACT_FROM_EMAIL is set explicitly.
RESEND_VERIFIED_DOMAIN=techrynex.com

# Where contact form submissions are delivered.
# Falls back to COMPANY_EMAIL in lib/data.ts if unset.
CONTACT_TO_EMAIL=Procurement@techrynex.com

# Optional — overrides the generated "from" address.
# CONTACT_FROM_EMAIL=contact@techrynex.com
